---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const journals = await getCollection('journals', j => !j.data.draft);
const sorted = journals.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="journals — engineering archive">
  <section style="padding-top:4rem;">
    <div class="section-header">
      <h2>journals</h2>
      <div class="divider"></div>
      <span class="ts">{sorted.length} entries</span>
    </div>
    <div class="content-list">
      {sorted.map(j => {
        const dateStr = j.data.date ? j.data.date.toISOString().split('T')[0] : '';
        return (
          <a href={`/journals/${j.id}`} class="content-entry">
            <div class="content-meta">
              <span>{dateStr}</span>
              {j.data.project && <span>→ {j.data.project}</span>}
              {j.data.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
            <div class="content-title">{j.data.title || `Journal — ${dateStr}`}</div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
