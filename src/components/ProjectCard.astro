---
export interface Props {
  project: any;
}

const { project } = Astro.props;
const { title, status, description, tags, version, started } = project.data;

const statusClass = {
  active: 'status-active',
  paused: 'status-paused',
  archived: 'status-archived',
  learning: 'status-learning',
  unstable: 'status-learning',
  stable: 'status-active'
}[status] || 'status-paused';

const startedStr = started ? started.toISOString().slice(0, 7) : 'unknown';
---

<a href={`/projects/${project.id}`} class="project-entry">
  <div>
    <div class="project-meta">
      <span>{project.id}</span>
      <span>{startedStr} → present</span>
      <span>v{version}</span>
    </div>
    <div class="project-title">{title}</div>
    <div class="project-desc">{description}</div>
    <div class="project-tags">
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
  <span class={`project-status ${statusClass}`}>{status}</span>
</a>