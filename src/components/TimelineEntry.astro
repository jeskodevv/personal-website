---
export interface Props {
  date: string;
  title: string;
  description: string;
  active?: boolean;
}

const { date, title, description, active = false } = Astro.props;
---

<div class={`tl-entry ${active ? 'active' : ''}`}>
  <div class="tl-date">{date}</div>
  <div class="tl-title">{title}</div>
  <div class="tl-desc">{description}</div>
</div>