---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const writings = await getCollection('writings', w => !w.data.draft);
const sorted = writings.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="writings — engineering archive">
  <section style="padding-top:4rem;">
    <div class="section-header">
      <h2>writings</h2>
      <div class="divider"></div>
      <span class="ts">{sorted.length} entries</span>
    </div>
    <div class="content-list">
      {sorted.map(w => (
        <a href={`/writings/${w.id}`} class="content-entry">
          <div class="content-meta">
            <span>{w.data.date.toISOString().split('T')[0]}</span>
            {w.data.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
          <div class="content-title">{w.data.title}</div>
          <div class="content-desc">{w.data.description}</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>