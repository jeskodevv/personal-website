---
export interface Props {
  experiment: any;
}

const { experiment } = Astro.props;
const { title, status, started, hypothesis, conclusion, tags } = experiment.data;
const startedStr = started ? started.toISOString().split('T')[0] : '';
---

<div class="experiment-card">
  <div class="experiment-header">
    <div class="experiment-title">{title}</div>
    <span class={`experiment-status ${status}`}>{status}</span>
  </div>
  <div class="experiment-meta">started {startedStr} {tags.map(t => <span class="tag">{t}</span>)}</div>
  {hypothesis && (
    <div class="experiment-section">
      <div class="experiment-key">hypothesis</div>
      <div class="experiment-val">{hypothesis}</div>
    </div>
  )}
  {conclusion && (
    <div class="experiment-section">
      <div class="experiment-key">conclusion</div>
      <div class="experiment-val">{conclusion}</div>
    </div>
  )}
  <div class="experiment-section">
    <div class="experiment-key">log</div>
    <div class="experiment-val">{experiment.body}</div>
  </div>
</div>
