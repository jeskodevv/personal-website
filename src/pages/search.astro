---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="search — engineering archive">
  <section style="padding-top:4rem;">
    <div class="section-header">
      <h2>search</h2>
      <div class="divider"></div>
      <span class="ts">search the archive</span>
    </div>
    <div class="search-wrap">
      <span class="search-prompt">$</span>
      <input type="text" id="search-input" placeholder="type to search..." autocomplete="off" spellcheck="false" />
    </div>
    <div class="search-results" id="search-results"></div>
  </section>

  <script>
    // Client-side search using a pre-built index
    let searchIndex = [];

    async function loadIndex() {
      try {
        const res = await fetch('/search-index.json');
        searchIndex = await res.json();
      } catch (e) {
        console.error('Failed to load search index:', e);
      }
    }

    loadIndex();

    document.getElementById('search-input').addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      const container = document.getElementById('search-results');
      if (!q) { container.innerHTML = ''; return; }

      const matches = searchIndex.filter(e => 
        e.title.toLowerCase().includes(q) || 
        (e.type && e.type.toLowerCase().includes(q))
      );

      if (!matches.length) {
        container.innerHTML = '<div class="search-result-item"><span class="sr-type">—</span><span class="sr-title">no results</span></div>';
        return;
      }

      container.innerHTML = matches.map(m => {
        const hi = m.title.replace(new RegExp(`(${q})`, 'gi'), '<mark>$1</mark>');
        return `<div class="search-result-item"><span class="sr-type">${m.type}</span><span class="sr-title">${hi}</span></div>`;
      }).join('');
    });
  </script>
</BaseLayout>