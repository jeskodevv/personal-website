---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const activeProjects = projects.filter(p => p.data.status === 'active' && !p.data.draft);
const learningProjects = projects.filter(p => p.data.status === 'learning' && !p.data.draft);
const experiments = await getCollection('lab');
const activeExperiments = experiments.filter(e => e.data.status === 'active' && !e.data.draft);
---

<div class="status-panel">
  <div class="status-block">
    <div class="sb-key">system</div>
    <div class="sb-val"><span class="dot">●</span>operational</div>
  </div>

  <div class="status-block">
    <div class="sb-key">currently building</div>
    <div class="sb-val">
      {activeProjects.slice(0, 2).map(p => (
        <div><span class="dot">→</span>{p.data.title}</div>
      ))}
    </div>
  </div>

  <div class="status-block">
    <div class="sb-key">currently learning</div>
    <div class="sb-val">
      {learningProjects.slice(0, 2).map(p => (
        <div><span class="dot">→</span>{p.data.title}</div>
      ))}
    </div>
  </div>

  <div class="status-block">
    <div class="sb-key">active experiments</div>
    <div class="sb-val">
      {activeExperiments.slice(0, 2).map(e => (
        <div><span class="dot">→</span>{e.data.title}</div>
      ))}
    </div>
  </div>

  <div class="status-block">
    <div class="sb-key">current problem</div>
    <div class="sb-val">
      <span class="warn-dot">⚠</span>synchronization instability<br/>
      <span class="warn-dot">⚠</span>latency under load
    </div>
  </div>

  <div class="status-block">
    <div class="sb-key">mood / energy</div>
    <div class="sb-val">focused. slightly caffeinated.<br/>suspicious of complexity.</div>
  </div>
</div>