---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const tools = await getCollection('toolbox');
const sorted = tools.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title="toolbox — engineering archive">
  <section style="padding-top:4rem;">
    <div class="section-header">
      <h2>toolbox</h2>
      <div class="divider"></div>
      <span class="ts">{sorted.length} tools</span>
    </div>
    <div class="toolbox-list">
      {sorted.map(t => (
        <div class="tool-entry">
          <div class="tool-name">
            {t.data.name}
            {t.data.version && <span class="version">{t.data.version}</span>}
          </div>
          <div class="tool-reason">
            <strong>Why:</strong> {t.data.why}
            {t.data.alternatives && (
              <><br/><strong>Why not alternatives:</strong> {t.data.alternatives}</>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>