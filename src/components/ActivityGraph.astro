---
import { getCollection } from 'astro:content';

const [journals, notes, projects] = await Promise.all([
  getCollection('journals'),
  getCollection('notes'),
  getCollection('projects')
]);

const activityMap = new Map();
const allContent = [...journals, ...notes, ...projects];

allContent.forEach(item => {
  const date = new Date(item.data.date || item.data.started || item.data.updated || Date.now()).toISOString().split('T')[0];
  activityMap.set(date, (activityMap.get(date) || 0) + 1);
});

const weeks = 52;
const days = 7;
const today = new Date();
const grid = [];

for (let w = 0; w < weeks; w++) {
  const week = [];
  for (let d = 0; d < days; d++) {
    const date = new Date(today);
    date.setDate(date.getDate() - ((weeks - w - 1) * 7 + (days - d - 1)));
    const dateStr = date.toISOString().split('T')[0];
    const count = activityMap.get(dateStr) || 0;

    let level = 0;
    if (count === 1) level = 1;
    else if (count === 2) level = 2;
    else if (count <= 4) level = 3;
    else if (count > 4) level = 4;

    week.push({ date: dateStr, level, count });
  }
  grid.push(week);
}
---

<div class="graph-wrap">
  <div class="activity-grid">
    {grid.map(week => (
      <div class="activity-col">
        {week.map(day => (
          <div 
            class="activity-cell" 
            data-level={day.level || undefined}
            title={`${day.date}${day.count ? ' — ' + day.count + ' activities' : ''}`}
          />
        ))}
      </div>
    ))}
  </div>
</div>

<div class="graph-legend">
  <span>less</span>
  <div class="cells">
    <div class="legend-cell" style="background:var(--surface)"></div>
    <div class="legend-cell" style="background:var(--accent-bg);border:1px solid var(--accent-dim)"></div>
    <div class="legend-cell" style="background:var(--accent-dim);opacity:0.5"></div>
    <div class="legend-cell" style="background:var(--accent-dim);opacity:0.8"></div>
    <div class="legend-cell" style="background:var(--accent)"></div>
  </div>
  <span>more</span>
</div>