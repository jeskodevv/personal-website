---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const notes = await getCollection('notes', n => !n.data.draft);
const sorted = notes.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="notes — engineering archive">
  <section style="padding-top:4rem;">
    <div class="section-header">
      <h2>notes</h2>
      <div class="divider"></div>
      <span class="ts">{sorted.length} entries</span>
    </div>
    <div class="notes-grid">
      {sorted.map(n => {
        const dateStr = n.data.date ? n.data.date.toISOString().split('T')[0] : '';
        return (
          <a href={`/notes/${n.id}`} class="note-card">
            <div class="note-ts">{dateStr}</div>
            <div class="note-body">{n.body}</div>
            {n.data.tags.length > 0 && <div class="note-tag">#{n.data.tags.join(' #')}</div>}
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
