---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = "A living archive of systems, experiments, and ideas built in public." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark" data-version="0.7">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,300;0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300;1,6..72,400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>

<!-- Command Palette -->
<div id="cmd-overlay" role="dialog" aria-modal="true" aria-label="Command palette">
  <div id="cmd-box">
    <div id="cmd-input-wrap">
      <span class="prompt">›</span>
      <input id="cmd-input" type="text" placeholder="type a command or search..." autocomplete="off" spellcheck="false" />
    </div>
    <div id="cmd-results"></div>
    <div id="cmd-footer">
      <span>↑↓ navigate</span>
      <span>↵ select</span>
      <span>esc close</span>
    </div>
  </div>
</div>

<!-- Konami Easter Egg -->
<div id="konami-overlay">
  <pre id="konami-art"></pre>
  <p>you found it. close with esc.</p>
</div>

<!-- Top Bar -->
<header id="topbar">
  <div class="topbar-left">
    <span class="site-id">site.v0.7</span>
    <span style="color:var(--text-muted)">
      <span class="status-dot"></span>online
    </span>
  </div>
  <div class="topbar-right">
    <div class="theme-switcher">
      <button class="theme-btn dark" title="dark theme" onclick="setTheme('dark')"><span></span></button>
      <button class="theme-btn warm" title="warm paper" onclick="setTheme('warm')"><span></span></button>
      <button class="theme-btn gray" title="grayscale" onclick="setTheme('gray')"><span></span></button>
    </div>
    <button class="cmd-trigger" onclick="openCmd()" title="Open command palette (⌘K)">
      <span>⌘K</span>
      <span>command</span>
    </button>
  </div>
</header>

<main>
  <div class="container">
    <slot />
  </div>
</main>

<footer>
  <div class="container">
    <div class="footer-inner">
      <div class="footer-links">
        <a href="https://github.com/jeskodevv" target="_blank" rel="noopener">github</a>
        <a href="https://t.me/kim_edim">telegram</a>
        <a href="mailto:hello@example.com">email</a>
        <a href="#" onclick="openCmd(); return false;">⌘K</a>
      </div>
      <span>site.v0.7 / built in public</span>
    </div>
  </div>
</footer>

<script is:inline>
/* Theme */
function setTheme(t) {
  document.documentElement.dataset.theme = t;
  localStorage.setItem('theme', t);
}
(function() {
  const t = localStorage.getItem('theme') || 'dark';
  setTheme(t);
})();

/* Uptime */
(function() {
  const start = new Date('2026-05-21T00:00:00Z');
  function update() {
    const now = new Date();
    const diff = Math.floor((now - start) / 1000);
    const d = Math.floor(diff / 86400);
    const h = Math.floor((diff % 86400) / 3600);
    const m = Math.floor((diff % 3600) / 60);
    const el = document.getElementById('uptime');
    if (el) el.textContent = d + 'd ' + h + 'h ' + m + 'm';
  }
  update();
  setInterval(update, 30000);
})();

/* Command Palette */
const COMMANDS = [
  { tag: 'nav', label: 'go to → status panel', action: () => goto('#status') },
  { tag: 'nav', label: 'go to → projects', action: () => goto('#projects') },
  { tag: 'nav', label: 'go to → notes', action: () => goto('#notes') },
  { tag: 'nav', label: 'go to → now page', action: () => goto('#now') },
  { tag: 'nav', label: 'go to → toolbox', action: () => goto('#toolbox') },
  { tag: 'nav', label: 'go to → residue archive', action: () => goto('#residue') },
  { tag: 'nav', label: 'go to → search', action: () => { goto('#search-section'); setTimeout(() => document.getElementById('search-input').focus(), 400); } },
  { tag: 'theme', label: 'theme → dark', action: () => setTheme('dark') },
  { tag: 'theme', label: 'theme → warm paper', action: () => setTheme('warm') },
  { tag: 'theme', label: 'theme → grayscale', action: () => setTheme('gray') },
  { tag: 'action', label: 'open → github', action: () => window.open('https://github.com', '_blank') },
  { tag: 'action', label: 'compose → email', action: () => window.location.href = 'mailto:hello@example.com' },
  { tag: 'secret', label: 'easter egg → activate', action: () => { closeCmd(); showKonami(); } },
];

function goto(hash) {
  closeCmd();
  const el = document.querySelector(hash);
  if (el) el.scrollIntoView({ behavior: 'smooth' });
}

let cmdActive = 0;

function openCmd() {
  document.getElementById('cmd-overlay').classList.add('open');
  document.getElementById('cmd-input').value = '';
  renderCmdResults('');
  document.getElementById('cmd-input').focus();
  cmdActive = 0;
}

function closeCmd() {
  document.getElementById('cmd-overlay').classList.remove('open');
}

function renderCmdResults(q) {
  const results = document.getElementById('cmd-results');
  const filtered = q
    ? COMMANDS.filter(c => c.label.toLowerCase().includes(q.toLowerCase()))
    : COMMANDS;

  results.innerHTML = filtered.map((c, i) => `
    <div class="cmd-item${i === cmdActive ? ' active' : ''}" data-idx="${i}" onclick="execCmd(${i})">
      <span class="cmd-tag">${c.tag}</span>
      <span class="cmd-label">${c.label.replace(/→/g, '<em>→</em>')}</span>
    </div>
  `).join('');
}

function execCmd(idx) {
  const q = document.getElementById('cmd-input').value;
  const filtered = q
    ? COMMANDS.filter(c => c.label.toLowerCase().includes(q.toLowerCase()))
    : COMMANDS;
  if (filtered[idx]) filtered[idx].action();
  closeCmd();
}

document.getElementById('cmd-input').addEventListener('input', function() {
  cmdActive = 0;
  renderCmdResults(this.value);
});

document.getElementById('cmd-input').addEventListener('keydown', function(e) {
  const items = document.querySelectorAll('.cmd-item');
  if (e.key === 'ArrowDown') { cmdActive = Math.min(cmdActive + 1, items.length - 1); }
  if (e.key === 'ArrowUp')   { cmdActive = Math.max(cmdActive - 1, 0); }
  if (e.key === 'Enter')     { execCmd(cmdActive); }
  if (e.key === 'Escape')    { closeCmd(); }
  items.forEach((el, i) => el.classList.toggle('active', i === cmdActive));
});

document.getElementById('cmd-overlay').addEventListener('click', function(e) {
  if (e.target === this) closeCmd();
});

document.addEventListener('keydown', function(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openCmd(); }
  if (e.key === 'Escape') closeCmd();
});

/* Konami */
const KONAMI = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
let konamiPos = 0;

const ASCII = `
    ██████╗  ██████╗ 
    ██╔══██╗██╔═══██╗
    ██████╔╝██║   ██║
    ██╔══██╗██║   ██║
    ██║  ██║╚██████╔╝
    ╚═╝  ╚═╝ ╚═════╝ 

    yo congrats, looks like you've
    found some easter eggs :)
    you are clearly a person
    who reads documentation.

    ↑ ↑ ↓ ↓ ← → ← → B A

    site.v0.7 // hidden layer`;

document.addEventListener('keydown', function(e) {
  if (e.key === KONAMI[konamiPos]) {
    konamiPos++;
    if (konamiPos === KONAMI.length) {
      konamiPos = 0;
      showKonami();
    }
  } else {
    konamiPos = 0;
  }
});

function showKonami() {
  document.getElementById('konami-art').textContent = ASCII;
  document.getElementById('konami-overlay').classList.add('show');
}

document.getElementById('konami-overlay').addEventListener('click', function() {
  this.classList.remove('show');
});

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    document.getElementById('konami-overlay').classList.remove('show');
  }
});
</script>

</body>
</html>
