---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const archives = await getCollection('archives');
const sorted = archives.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="residue — engineering archive">
  <section style="padding-top:4rem;">
    <div class="section-header">
      <h2>residue</h2>
      <div class="divider"></div>
      <span class="ts">deprecated experiments & abandoned ideas</span>
    </div>
    <div class="residue-list">
      {sorted.map(a => (
        <div class="residue-item">
          <div class="residue-name">{a.data.title}</div>
          <div class="residue-why">{a.data.reason}</div>
          <div class="residue-date">
            {a.data.originalType || 'project'} abandoned {a.data.date.toISOString().split('T')[0]}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>